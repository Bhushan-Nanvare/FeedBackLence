# ============================================================================
# FeedbackLens Frontend — production Dockerfile
#
# Multi-stage build:
#   1. "deps"     — installs node_modules (cached unless package-lock.json changes)
#   2. "builder"  — runs `next build` with standalone output
#   3. "runtime"  — copies only the standalone bundle, public/ and .next/static/
#
# The address of the API is baked in at build time, because Next.js replaces
# NEXT_PUBLIC_* variables in the browser bundle while building. Setting it only
# at run time would leave the browser talking to localhost.
#
# Usage:
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://api.example.com \
#                -t feedbacklens-web web/
#   docker run -p 3000:3000 feedbacklens-web
# ============================================================================

# ---------- Stage 1: install dependencies ----------
FROM node:24-alpine AS deps

WORKDIR /app

# Copy manifests first so Docker can cache this layer separately.
COPY package.json package-lock.json ./

# ci = reproducible install, exactly what's in the lockfile.
RUN npm ci --prefer-offline

# ---------- Stage 2: build ----------
FROM node:24-alpine AS builder

WORKDIR /app

# Bring in node_modules from the deps stage.
COPY --from=deps /app/node_modules ./node_modules

# Copy the full source.
COPY . .

# Where the browser should send API requests. Defaults to local development.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# next.config.ts sets output: "standalone", which writes the server bundle
# copied into the runtime stage below.
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---------- Stage 3: production runtime ----------
FROM node:24-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create a non-root user. Alpine's adduser is BusyBox's, so these are its flags:
# -g group, -u uid, -G primary group, -D no password.
RUN addgroup -g 1001 nodejs && adduser -u 1001 -G nodejs -D nextjs

# Copy the minimal standalone bundle generated by Next.js.
# standalone/  — self-contained server (server.js + all server deps)
# static/      — pre-rendered pages and chunks served by the CDN / nginx
# public/      — static assets (fonts, images, etc.)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

# Next.js standalone server listens on 3000 by default.
EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# The standalone output drops a `server.js` at the root.
CMD ["node", "server.js"]
