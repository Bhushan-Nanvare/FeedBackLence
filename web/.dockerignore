# web/.dockerignore
# Used when building the frontend image (docker build -t feedbacklens-web web/).

# Node artefacts (installed fresh inside the image by npm ci)
node_modules/

# Next.js build output (built fresh inside the image)
.next/

# TypeScript build info (regenerated by tsc during build)
*.tsbuildinfo

# Local environment
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tests and CI
*.test.*
*.spec.*
