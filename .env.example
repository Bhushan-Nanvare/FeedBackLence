# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://feedbacklens:feedbacklens@localhost:5434/feedbacklens
CORS_ORIGINS=["http://localhost:3000"]

# Optional. Without a token GitHub allows 60 API requests/hour; with one, 5,000.
# Use a fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=

# Required for AI tagging. Create a key at https://aistudio.google.com/apikey
# On the free tier Google may use prompts to improve its products, so send only public data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Check your account's limit at https://aistudio.google.com/rate-limit
GEMINI_REQUESTS_PER_MINUTE=10
