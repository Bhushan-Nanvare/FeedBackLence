# Copy to .env and adjust. Never commit .env.
#
# ── Local development ────────────────────────────────────────────────────────
# Uses the database started by `docker compose up -d` (port 5434).
DATABASE_URL=postgresql+psycopg://feedbacklens:feedbacklens@localhost:5434/feedbacklens
CORS_ORIGINS=["http://localhost:3000"]

# ── Production (docker-compose.production.yml) ───────────────────────────────
# The production compose file reads DATABASE_URL from these variables and
# connects to the db service on the internal Docker network (port 5432).
# The DATABASE_URL line above is ignored by docker-compose.production.yml.
POSTGRES_USER=feedbacklens
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=feedbacklens

# Where each half of the app is reachable from a browser. PUBLIC_WEB_URL is also
# what the API allows through CORS and what alert links point at; PUBLIC_API_URL is
# baked into the frontend bundle, so changing it means rebuilding the web image.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Signs sign-in tokens. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without it the API makes a temporary one at startup, so every restart signs everyone out.
AUTH_SECRET_KEY=
# How long someone stays signed in.
AUTH_TOKEN_DAYS=7

# Optional. Without a token GitHub allows 60 API requests/hour; with one, 5,000.
# Use a fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=

# Required for AI tagging. Create a key at https://aistudio.google.com/apikey
# On the free tier Google may use prompts to improve its products, so send only public data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Check your account's limit at https://aistudio.google.com/rate-limit
GEMINI_REQUESTS_PER_MINUTE=10

# Where embeddings (used for grouping feedback) come from.
# "local" runs a small model on this machine: no key, no quota, no cost.
# It needs the optional package: cd backend && uv sync --extra local-embeddings
# "gemini" uses the API key above instead.
EMBEDDING_PROVIDER=local

# Optional. Where alerts about fast-growing themes are sent. Without this they are
# still recorded and shown on the dashboard, but nothing is sent anywhere.
SLACK_WEBHOOK_URL=
# Optional. Lets an alert link back to the theme, e.g. https://feedbacklens.example.com
PUBLIC_WEB_URL=

# Where tickets are filed. Must be a repository you own: filing into a repository you
# only import from would post into someone else's project, and is refused.
# Filing also needs GITHUB_TOKEN above to have write access to it.
TICKET_REPO=
